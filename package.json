{
  "name": "fieldwork-facilities",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx scripts/seed.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.json README.md",
    "format:check": "prettier --check src tests scripts *.ts *.json README.md"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.0",
    "lucide-react": "^0.577.0",
    "next": "^16.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}

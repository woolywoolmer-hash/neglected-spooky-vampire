{
  "name": "Fieldwork V1 private demo",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5.2.5-24-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Fieldwork demo",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "postCreateCommand": "npm ci && npm run build",
  "postStartCommand": "bash .devcontainer/start-demo.sh",
  "remoteEnv": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  }
}

# Local development uses embedded PostgreSQL and dummy data by default.
# Persistent local database path, optional:
# DEMO_DATABASE_PATH=.data/fieldwork
# Production demo is disabled unless explicitly enabled. Never use with real data.
# ALLOW_DEMO=true

# Set BOTH to use Supabase Auth and hosted PostgreSQL instead of the demo.
# Apply supabase/migrations/001_core.sql and 002_supabase_auth.sql then seed.sql.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# No service role key is needed or used.
